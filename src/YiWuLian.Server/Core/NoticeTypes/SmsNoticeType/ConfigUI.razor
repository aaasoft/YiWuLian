@using MudBlazor

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="配置">
        <MudSwitch @bind-Value="Enable" Label="启用" Color="Color.Success" />
        <MudTextField @bind-Value="@config.ApiAddress" Label="API地址" Variant="Variant.Outlined"
            ReadOnly="configModel.Enable" />
        <MudTextField @bind-Value="@config.EcName" Label="企业名称" Variant="Variant.Outlined"
            ReadOnly="configModel.Enable" />
        <MudTextField @bind-Value="@config.AddSerial" Label="扩展码" Variant="Variant.Outlined"
            ReadOnly="configModel.Enable" />
        <MudTextField @bind-Value="@config.ApId" Label="接口账号用户名" Variant="Variant.Outlined"
            ReadOnly="configModel.Enable" />
        <MudTextField @bind-Value="@config.SecretKey" Label="接口账号密码" Variant="Variant.Outlined"
            ReadOnly="configModel.Enable" />
        <MudTextField @bind-Value="@config.Sign" Label="签名编码" Variant="Variant.Outlined"
            ReadOnly="configModel.Enable" />
        <MudTextField @bind-Value="@config.TemplateId" Label="模板ID" Variant="Variant.Outlined"
            ReadOnly="configModel.Enable" />
    </MudTabPanel>
    @if (Enable)
    {
        <MudTabPanel Text="测试">
            <MudTextField @bind-Value="targets" Label="通知目标"></MudTextField>
            <MudTextField Lines="5" @bind-Value="content" Label="内容"></MudTextField>
            <MudButton OnClick="Send">发送</MudButton>
            <MudOverlay Visible="@isSending" DarkBackground="true" Absolute="true">
                <MudCard>
                    <MudCardContent>
                        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
                        <MudText Typo="Typo.body2">正在发送中...</MudText>
                    </MudCardContent>
                </MudCard>
            </MudOverlay>
        </MudTabPanel>
    }
</MudTabs>
