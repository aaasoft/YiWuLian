@page "/notice_log"
@using Quick.EntityFrameworkCore.Plus

<PageTitle>通知日志</PageTitle>

<MudToolBar>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Refresh">刷新</MudButton>
</MudToolBar>

<MudDataGrid T="Models.YIS_NoticeLog" Items="@Elements" SortMode="SortMode.Single" Filterable="true"
    FilterMode="DataGridFilterMode.Simple">
    <Columns>
        <PropertyColumn Property="x => x.OrderNo" Title="序号" Filterable="false" Sortable="false" Hidden="true" />
        <PropertyColumn Property="x => x.DeviceId" Title="设备编号" Sortable="false" />
        <PropertyColumn Property="x => x.DeviceName" Title="设备名称" Sortable="false" />
        <PropertyColumn Property="x => x.Time" Title="时间" InitialDirection="SortDirection.Descending" />
        <PropertyColumn Property="x => x.NoticeType" Title="类型" Filterable="false" Sortable="false" />
        <PropertyColumn Property="x => x.NoticeTarget" Title="目标" Sortable="false" />
        <PropertyColumn Property="x => x.NoticeContent" Title="内容" Filterable="false" Sortable="false" />
        <PropertyColumn Property="x => x.NoticeResult" Title="结果" Filterable="false" Sortable="false" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Models.YIS_NoticeLog" />
    </PagerContent>
</MudDataGrid>