@page "/connection_log"

<PageTitle>连接日志</PageTitle>

<MudDataGrid @ref="dataGrid" T="Models.YIS_ConnectionLog" ServerData="LoadServerDataAsync" SortMode="SortMode.None" Filterable="false">
    <ToolBarContent>
        <MudText Typo="Typo.h6">连接日志</MudText>
        <MudSpacer />
        <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="查询" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.OrderNo" Title="序号" Hidden="true" />
        <PropertyColumn Property="x => x.DeviceId" Title="设备编号" />
        <PropertyColumn Property="x => x.DeviceName" Title="设备名称" />
        <PropertyColumn Property="x => x.Time" Title="时间" />
        <PropertyColumn Property="x => x.Content" Title="内容" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Models.YIS_ConnectionLog" />
    </PagerContent>
</MudDataGrid>