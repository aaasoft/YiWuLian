@page "/notice_log"

<PageTitle>通知日志</PageTitle>

<MudDataGrid @ref="dataGrid" T="Models.YIS_NoticeLog" ServerData="LoadServerDataAsync" SortMode="SortMode.None" Filterable="false">
    <ToolBarContent>
        <MudText Typo="Typo.h6">通知日志</MudText>
        <MudSpacer />
        <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="查询" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.OrderNo" Title="序号" Hidden="true" />
        <PropertyColumn Property="x => x.DeviceId" Title="设备编号" />
        <PropertyColumn Property="x => x.DeviceName" Title="设备名称" />
        <PropertyColumn Property="x => x.Time" Title="时间" />
        <PropertyColumn Property="x => x.NoticeType" Title="类型" />
        <PropertyColumn Property="x => x.NoticeTarget" Title="目标" />
        <PropertyColumn Property="x => x.NoticeContent" Title="内容" />
        <PropertyColumn Property="x => x.NoticeResult" Title="结果" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Models.YIS_NoticeLog" />
    </PagerContent>
</MudDataGrid>