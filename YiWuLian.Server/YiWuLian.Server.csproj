<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
	  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseSelfContained'">
    <PublishSingleFile>true</PublishSingleFile>
	  <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>	
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.6.0" />
    <PackageReference Include="MudBlazor.Translations" Version="3.3.0" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Quick.EntityFrameworkCore.Plus.SQLite" Version="2026.10.523" />
    <PackageReference Include="Quick.EntityFrameworkCore.Plus.MySql" Version="2026.10.523" />
    <PackageReference Include="Quick.Protocol.InterfaceService" Version="2.7.0" />
    <PackageReference Include="Quick.Protocol.WebSocket.Server.AspNetCore" Version="2.7.0" />
    <PackageReference Include="Quick.Sms.CMCC.CloudMAS" Version="2026.2.520" />
    <PackageReference Include="YiQiDong.Core" Version="2026.18.701" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
  </ItemGroup>
  
	<ItemGroup>
		<None Update="YiQiDong.Image.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
  
	<ItemGroup>
	  <ProjectReference Include="..\YiWuLian.Protocol\YiWuLian.Protocol.csproj" />
	</ItemGroup>

</Project>